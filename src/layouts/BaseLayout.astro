---
import { ClientRouter } from "astro:transitions";
import { serializeJsonLd } from "../lib/json-ld";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown>;
  appShell?: boolean;
};

const {
  title = "Brewly — Find any Homebrew package",
  description = "A fast, keyboard-first explorer for Homebrew formulae and casks.",
  canonicalPath = "/",
  jsonLd,
  appShell = false,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site ?? Astro.url);
const brandImage = new URL("/assets/brewly-logo.webp", Astro.site ?? Astro.url);
const repositoryUrl = import.meta.env.PUBLIC_REPOSITORY_URL ?? "https://github.com/nacholaciar/brewly";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem("brewly-theme");
          const theme = savedTheme === "light" || savedTheme === "dark" || savedTheme === "homebrew"
            ? savedTheme
            : window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme === "light" ? "light" : "dark";
        } catch {}
      })();
    </script>
    <meta id="theme-color" name="theme-color" content="#0b0c0d" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="brewly" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={brandImage} />
    <meta property="og:image:alt" content="Brewly logo: a copper bottle crate" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={brandImage} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
    <ClientRouter fallback="swap" />
  </head>
  <body class={appShell ? "app-shell" : undefined} transition:animate="none">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Brewly home" data-astro-prefetch="hover">
        <img src="/assets/brewly-logo.webp" width="600" height="678" alt="" />
        <span>Brewly</span>
      </a>
      <div class="header-actions">
        <nav aria-label="Primary navigation">
          <a href="/news" data-astro-prefetch="hover">News</a>
          <a href={repositoryUrl} rel="noreferrer">GitHub</a>
          <a href="/about" data-astro-prefetch="hover">About</a>
        </nav>
        <button
          class="theme-toggle"
          type="button"
          aria-label="Current theme: Dark. Switch to Homebrew theme"
          title="Dark theme — switch to Homebrew"
        >
          <svg class="sun-icon" aria-hidden="true" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
          </svg>
          <svg class="moon-icon" aria-hidden="true" viewBox="0 0 24 24">
            <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"></path>
          </svg>
          <svg class="beer-icon" aria-hidden="true" viewBox="0 0 24 24">
            <path d="M17 11h1a3 3 0 0 1 0 6h-1"></path>
            <path d="M9 12v6M13 12v6"></path>
            <path d="M14 7.5c-1 0-1.44.5-3 .5s-2-.5-3-.5-1.72.5-2.5.5a2.5 2.5 0 0 1 0-5c.78 0 1.57.5 2.5.5S9.44 2 11 2s2 1.5 3 1.5 1.72-.5 2.5-.5a2.5 2.5 0 0 1 0 5c-.78 0-1.5-.5-2.5-.5Z"></path>
            <path d="M5 8v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V8"></path>
          </svg>
        </button>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    {!appShell && (
      <footer class="site-footer">
        <p>Brewly is an independent project and is not affiliated with Homebrew.</p>
      </footer>
    )}
    <script>
      function setupThemeButton() {
        const button = document.querySelector(".theme-toggle");
        const themeColor = document.querySelector("#theme-color");
        if (!(button instanceof HTMLButtonElement)) return;

        const update = () => {
          const themes = ["dark", "homebrew", "light"];
          const labels: Record<string, string> = { dark: "Dark", homebrew: "Homebrew", light: "Light" };
          const currentTheme = document.documentElement.dataset.theme ?? "dark";
          const theme = themes.includes(currentTheme) ? currentTheme : "dark";
          const nextTheme = themes[(themes.indexOf(theme) + 1) % themes.length];
          button.setAttribute(
            "aria-label",
            `Current theme: ${labels[theme]}. Switch to ${labels[nextTheme]} theme`,
          );
          button.title = `${labels[theme]} theme — switch to ${labels[nextTheme]}`;
          if (themeColor instanceof HTMLMetaElement) {
            themeColor.content = theme === "dark" ? "#0b0c0d" : theme === "homebrew" ? "#2e2a24" : "#f6f5f2";
          }
        };

        update();
        if (button.dataset.themeReady) return;
        button.dataset.themeReady = "true";
        button.addEventListener("click", () => {
          const themes = ["dark", "homebrew", "light"];
          const currentTheme = document.documentElement.dataset.theme ?? "dark";
          const currentIndex = themes.includes(currentTheme) ? themes.indexOf(currentTheme) : 0;
          const theme = themes[(currentIndex + 1) % themes.length];
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme === "light" ? "light" : "dark";
          localStorage.setItem("brewly-theme", theme);
          update();
        });
      }

      document.addEventListener("astro:before-swap", (event) => {
        const theme = localStorage.getItem("brewly-theme") ?? document.documentElement.dataset.theme ?? "dark";
        event.newDocument.documentElement.dataset.theme = theme;
        event.newDocument.documentElement.style.colorScheme = theme === "light" ? "light" : "dark";
      });
      document.addEventListener("astro:page-load", setupThemeButton);
      setupThemeButton();
    </script>
  </body>
</html>
