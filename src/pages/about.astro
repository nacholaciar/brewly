---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About Brewly"
  description="Brewly is an independent, open-source explorer for Homebrew packages."
  canonicalPath="/about"
>
  <article class="content-page">
    <div class="about-brand">
      <img src="/assets/brewly-logo.webp" width="600" height="678" alt="Brewly" />
    </div>
    <h1>A faster way to explore Homebrew.</h1>
    <p>Brewly is an independent, open-source interface for discovering Homebrew formulae and casks.</p>
    <p>It is not affiliated with or endorsed by Homebrew. Package metadata belongs to its respective sources and maintainers.</p>
    <a class="text-link" href="https://github.com/nacholaciar/brewly">View the source on GitHub →</a>
  </article>
</BaseLayout>
