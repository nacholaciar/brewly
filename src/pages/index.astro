---
import SearchExperience from "../components/SearchExperience";
import { packages } from "../data/packages";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout appShell>
  <section class="hero">
    <div class="hero-copy">
      <div>
        <span class="section-label">Package explorer</span>
        <h1>Find any <span>Homebrew</span> package.</h1>
      </div>
      <p>Formulae and casks, instantly.</p>
    </div>
    <SearchExperience initialPackages={packages} client:load />
  </section>
</BaseLayout>
