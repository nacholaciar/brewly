---
import { loadPackages } from "../../lib/homebrew-data";
import SearchExperience from "../../components/SearchExperience";
import { packages as seedPackages } from "../../data/packages";
import { packagePath, type BrewPackage } from "../../lib/packages";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return loadPackages()
    .filter((item) => item.type === "cask")
    .map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props as { item: BrewPackage };
const initialPackages = [item, ...seedPackages.filter((candidate) => candidate.slug !== item.slug)];
---

<BaseLayout
  appShell
  title={`${item.name} — Homebrew Cask | Brewly`}
  description={`${item.description}. Install ${item.name} with Homebrew.`}
  canonicalPath={packagePath(item)}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: item.name,
    description: item.description,
    softwareVersion: item.version,
    url: item.homepage,
    applicationCategory: "DeveloperApplication",
  }}
>
  <section class="hero package-explorer">
    <div class="hero-copy">
      <div>
        <span class="section-label">Package explorer</span>
        <h1>Find any <span>Homebrew</span> package.</h1>
      </div>
      <p>Formulae and casks, instantly.</p>
    </div>
    <SearchExperience initialPackages={initialPackages} initialPackage={item} client:load />
  </section>
</BaseLayout>
